# --- PLATFORM BRANDING ---
PLATFORM_NAME=NEXHOST CLOUD
TAGLINE=Your Bots. Your Cloud.
DEVELOPER_HANDLE=@Harsh_54x
DEVELOPER_TELEGRAM=https://t.me/Harsh_54x
CURRENCY_SYMBOL=₹
SUPPORT_EMAIL=support@nexhostcloud.local

# --- SECURITY & AUTHENTICATION ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=nexhost_super_secret_production_key_change_in_production_998877
SESSION_EXPIRY_HOURS=72

# --- SUPER ADMIN CREDENTIALS (Auto-provisioned on initial boot) ---
SUPERADMIN_EMAIL=owner@nexhost.cloud
SUPERADMIN_USERNAME=owner
SUPERADMIN_PASSWORD=OwnerSecurePass2026!
SUPERADMIN_NAME="Platform Administrator"

# --- MANUAL UPI PAYMENT SETTINGS ---
ADMIN_UPI_ID=harsh54x@upi
ADMIN_UPI_NAME="NEXHOST CLOUD / Harsh"
ADMIN_PAYMENT_NOTE="NEXHOST Cloud Subscription"
UPI_QR_IMAGE_PATH="static/default_upi_qr.png"

# --- DATABASE CONFIGURATION ---
# Neon PostgreSQL URL (Production):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-purple-cherry-bcsvp5i7-pooler.c-16.us-east-1.aws.neon.tech/neondb?sslmode=require
# Or SQLite (Local testing):
DATABASE_URL=sqlite:///data/nexhost.db

# --- TELEGRAM PLATFORM BOT & ACCESS CONTROL ---
# Get from @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=
# Get from https://my.telegram.org/apps:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Your numeric Telegram User ID (Get from @userinfobot or @MissRose_bot).
# Only THIS user ID has master Owner access to approve/deny user requests!
TELEGRAM_OWNER_ID=0

# --- MONGODB (Optional - For Activity Logs & Telemetry) ---
# Get from MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/
MONGO_URI=

# --- WORKER INFRASTRUCTURE ---
# Choose: 'sandbox' (for local/testing process supervisor) or 'docker' (for dedicated Linux worker with Docker daemon)
WORKER_TYPE=sandbox
WORKER_URL=http://127.0.0.1:8000
WORKER_API_KEY=worker_shared_secret_token_12345
WORKER_DEFAULT_MEMORY_MB=512
WORKER_DEFAULT_CPU_LIMIT=1.0

# --- STORAGE ---
STORAGE_BASE_DIR=data/storage
BACKUP_BASE_DIR=data/backups
LOGS_BASE_DIR=data/logs

# --- GITHUB INTEGRATION ---
GITHUB_DEFAULT_BRANCH=main
GITHUB_API_TIMEOUT=30
